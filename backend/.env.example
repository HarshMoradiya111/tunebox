
# Set this to the real deployed Render URL in production (e.g. https://tunebox-7lr2.onrender.com)
BACKEND_PUBLIC_URL=http://localhost:5000

# Optional: HTTP/SOCKS proxy for youtube-dl to avoid 429 Too Many Requests on cloud servers
YOUTUBE_PROXY=

# Cloudinary (Local File Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
